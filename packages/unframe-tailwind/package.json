{
  "name": "@unframe/unframe-tailwind",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "pnpm build && node --test test/*.test.ts",
    "lint": "vp check src test",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "prepare": "pnpm build"
  },
  "dependencies": {
    "error-stack-parser": "2.1.4",
    "jiti": "2.7.0",
    "path-is-inside": "1.0.2",
    "postcss-load-config": "6.0.1",
    "semver": "7.8.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/path-is-inside": "1.0.3",
    "@types/semver": "7.8.0",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "tailwindcss-older": "npm:tailwindcss@4.3.3",
    "tailwindcss-postcss-older": "npm:@tailwindcss/postcss@4.3.3",
    "typescript": "6.0.3",
    "vite-plus": "catalog:"
  }
}
