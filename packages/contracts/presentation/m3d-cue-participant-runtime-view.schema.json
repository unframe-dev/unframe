                "required": ["assignmentEpoch", "runSequence"],
                "additionalProperties": false
              },
              "owner": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "presentation"
                      }
                    },
                    "required": ["kind"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "group"
                      },
                      "groupId": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                      },
                      "groupEntryEpoch": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": ["kind", "groupId", "groupEntryEpoch"],
                    "additionalProperties": false
                  }
                ]
              },
              "cause": {
                "type": "object",
                "properties": {
                  "cueId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                  },
                  "causeEventId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                  },
                  "groupId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                  },
                  "groupEntryEpoch": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "stepId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                  },
                  "stepEntryEpoch": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "cueId",
                  "causeEventId",
                  "groupId",
                  "groupEntryEpoch",
                  "stepId",
                  "stepEntryEpoch"
                ],
                "additionalProperties": false
              },
              "startedAtRuntimeTimeMilliseconds": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "kind": {
                "type": "string",
                "const": "timeline"
              },
              "timelineId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
              },
              "completion": {
                "type": "string",
                "enum": ["blocking", "nonBlocking"]
              }
            },
            "required": [
              "runId",
              "owner",
              "cause",
              "startedAtRuntimeTimeMilliseconds",
              "kind",
              "timelineId",
              "completion"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "runId": {
                "type": "object",
                "properties": {
                  "assignmentEpoch": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "runSequence": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": ["assignmentEpoch", "runSequence"],
                "additionalProperties": false
              },
              "owner": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "presentation"
                      }
                    },
                    "required": ["kind"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "group"
                      },
                      "groupId": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                      },
                      "groupEntryEpoch": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": ["kind", "groupId", "groupEntryEpoch"],
                    "additionalProperties": false
                  }
                ]
              },
              "cause": {
                "type": "object",
                "properties": {
                  "cueId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                  },
                  "causeEventId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                  },
                  "groupId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                  },
                  "groupEntryEpoch": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "stepId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                  },
                  "stepEntryEpoch": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "cueId",
                  "causeEventId",
                  "groupId",
                  "groupEntryEpoch",
                  "stepId",
                  "stepEntryEpoch"
                ],
                "additionalProperties": false
              },
              "startedAtRuntimeTimeMilliseconds": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "kind": {
                "type": "string",
                "const": "surfaceTransition"
              },
              "surfaceId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
              },
              "fromStateId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
              },
              "toStateId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
              },
              "durationMilliseconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "completion": {
                "type": "string",
                "const": "blocking"
              },
              "easing": {
                "type": "string",
                "enum": ["linear", "cubicIn", "cubicOut", "cubicInOut"]
              }
            },
            "required": [
              "runId",
              "owner",
              "cause",
              "startedAtRuntimeTimeMilliseconds",
              "kind",
              "surfaceId",
              "fromStateId",
              "toStateId",
              "durationMilliseconds",
              "completion",
              "easing"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "clock": {
      "type": "object",
      "properties": {
        "runtimeTimeMilliseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lifecycle": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "running"
                }
              },
              "required": ["kind"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "paused"
                },
                "reason": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                }
              },
              "required": ["kind", "reason"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "terminating"
                },
                "reason": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                }
              },
              "required": ["kind", "reason"],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": ["runtimeTimeMilliseconds", "lifecycle"],
      "additionalProperties": false
