  "required": [
    "projectionProfileId",
    "assignmentEpoch",
    "baseReliableSequence",
    "progression",
    "surfaceStates",
    "nodeStates",
    "mediaStates",
    "modelClipStates",
    "variables",
    "activeRuns",
    "clock",
    "presentationOrigin",
    "enabledLogicalInputs"
  ],
  "additionalProperties": false,
  "$id": "https://contracts.unframe.dev/presentation/m3d-cue-participant-runtime-view.schema.json"
}
