{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "projectionProfileId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "assignmentEpoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "baseReliableSequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "progression": {
      "type": "object",
      "properties": {
        "currentGroupId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "groupEntryEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "currentStepId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "stepEntryEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "stepEnteredAtRuntimeTimeMilliseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "phase": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "stable"
                }
              },
              "required": ["kind"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "transitioning"
                },
                "blockingRunIds": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "assignmentEpoch": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "runSequence": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": ["assignmentEpoch", "runSequence"],
                    "additionalProperties": false
                  }
                },
                "pendingNext": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "stay"
                        }
                      },
                      "required": ["kind"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "end"
                        }
                      },
                      "required": ["kind"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "step"
                        },
                        "stepId": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                        }
                      },
                      "required": ["kind", "stepId"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "group"
                        },
                        "groupId": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                        }
                      },
                      "required": ["kind", "groupId"],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": ["kind", "blockingRunIds", "pendingNext"],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "currentGroupId",
        "groupEntryEpoch",
        "currentStepId",
        "stepEntryEpoch",
        "stepEnteredAtRuntimeTimeMilliseconds",
        "phase"
      ],
      "additionalProperties": false
    },
    "surfaceStates": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "stateId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "transitionRunId": {
            "type": "object",
            "properties": {
              "assignmentEpoch": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "runSequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": ["assignmentEpoch", "runSequence"],
            "additionalProperties": false
          }
