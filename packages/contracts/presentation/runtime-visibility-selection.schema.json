{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "projectionProfileId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "role": {
      "type": "string",
      "enum": ["presenter", "viewer"]
    },
    "visibleNodeIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
      }
    },
    "visibleSurfaceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
      }
    },
    "visibleVariableIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
      }
    }
  },
  "required": [
    "projectionProfileId",
    "role",
    "visibleNodeIds",
    "visibleSurfaceIds",
    "visibleVariableIds"
  ],
  "additionalProperties": false,
  "$id": "https://contracts.unframe.dev/presentation/runtime-visibility-selection.schema.json"
}
