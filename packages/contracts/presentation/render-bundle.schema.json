{
  "$id": "https://contracts.unframe.dev/presentation/render-bundle.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SerializedRenderBundleV1",
  "type": "object",
  "properties": {
    "buildContext": {
      "type": "object",
      "properties": {
        "colorScheme": {
          "type": "string",
          "enum": [
            "light",
            "dark"
          ]
        },
        "locale": {
          "$ref": "#/$defs/__schema0"
        },
        "themeHash": {
          "$ref": "#/$defs/__schema0"
        },
        "themeId": {
          "$ref": "#/$defs/__schema0"
        },
        "timezone": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "colorScheme",
        "locale",
        "themeHash",
        "themeId",
        "timezone"
      ],
      "additionalProperties": false
    },
    "bundleId": {
      "$ref": "#/$defs/__schema0"
    },
    "compiler": {
      "type": "object",
      "properties": {
        "environmentHash": {
          "$ref": "#/$defs/__schema0"
        },
        "name": {
          "$ref": "#/$defs/__schema0"
        },
        "version": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "environmentHash",
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "definitionHash": {
      "$ref": "#/$defs/__schema0"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "sourceHash": {
      "$ref": "#/$defs/__schema0"
    },
    "surfaces": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "interactionsByState": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "bounds": {
                    "$ref": "#/$defs/__schema1"
                  },
                  "coordinateSpace": {
                    "type": "string",
                    "const": "normalized"
                  },
                  "event": {
                    "$ref": "#/$defs/__schema0"
                  },
                  "interactionId": {
                    "$ref": "#/$defs/__schema0"
                  },
                  "priority": {
                    "type": "number"
                  },
                  "semanticNodeId": {
                    "$ref": "#/$defs/__schema0"
                  }
                },
                "required": [
                  "bounds",
                  "coordinateSpace",
                  "event",
                  "interactionId",
                  "priority",
                  "semanticNodeId"
                ],
                "additionalProperties": false
              }
            }
          },
          "logicalSize": {
            "$ref": "#/$defs/__schema3"
          },
          "physicalSizeMeters": {
            "$ref": "#/$defs/__schema3"
          },
          "renderSurfaceIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "renderSurfaces": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "artifacts": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "$ref": "#/$defs/__schema0"
                      },
                      "kind": {
                        "type": "string",
                        "const": "baked-web"
                      },
                      "states": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "type": "object",
                          "properties": {
                            "stateId": {
                              "$ref": "#/$defs/__schema0"
                            },
                            "textures": {
                              "minItems": 1,
                              "type": "array",
                              "items": {
                                "$ref": "#/$defs/__schema4"
                              }
                            }
                          },
                          "required": [
                            "stateId",
                            "textures"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "id",
                      "kind",
                      "states"
                    ],
                    "additionalProperties": false
                  }
                },
                "id": {
                  "$ref": "#/$defs/__schema0"
                },
                "layer": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "logicalBounds": {
                  "$ref": "#/$defs/__schema1"
                },
                "semanticSurfaceId": {
                  "$ref": "#/$defs/__schema0"
                },
                "stateBindings": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "empty"
                          }
                        },
                        "required": [
                          "kind"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "artifactIds": {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "$ref": "#/$defs/__schema0"
                            }
                          },
                          "kind": {
                            "type": "string",
                            "const": "artifacts"
                          }
                        },
                        "required": [
                          "artifactIds",
                          "kind"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                }
              },
              "required": [
                "artifacts",
                "id",
                "layer",
                "logicalBounds",
                "semanticSurfaceId",
                "stateBindings"
              ],
              "additionalProperties": false
            }
          },
          "semanticsByState": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "nodes": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "alt": {
                        "type": "string"
                      },
                      "id": {
                        "$ref": "#/$defs/__schema0"
                      },
                      "interactionId": {
                        "$ref": "#/$defs/__schema0"
                      },
                      "language": {
                        "type": "string"
                      },
                      "order": {
                        "type": "number"
                      },
                      "parentId": {
                        "anyOf": [
                          {
                            "$ref": "#/$defs/__schema0"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "role": {
                        "type": "string",
                        "enum": [
                          "heading",
                          "paragraph",
                          "image",
                          "button",
                          "table",
                          "list",
                          "listItem"
                        ]
                      },
                      "text": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "id",
                      "order",
                      "parentId",
                      "role"
                    ],
                    "additionalProperties": false
                  }
                },
                "rootNodeIds": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema0"
                  }
                }
              },
              "required": [
                "nodes",
                "rootNodeIds"
              ],
              "additionalProperties": false
            }
          },
          "semanticSurfaceId": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": [
          "interactionsByState",
          "logicalSize",
          "physicalSizeMeters",
          "renderSurfaceIds",
          "renderSurfaces",
          "semanticsByState",
          "semanticSurfaceId"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "buildContext",
    "bundleId",
    "compiler",
    "definitionHash",
    "schemaVersion",
    "sourceHash",
    "surfaces"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "height": {
          "$ref": "#/$defs/__schema2"
        },
        "width": {
          "$ref": "#/$defs/__schema2"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "height",
        "width",
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "__schema3": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/__schema2"
        },
        {
          "$ref": "#/$defs/__schema2"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "alphaMode": {
          "type": "string",
          "enum": [
            "opaque",
            "straight",
            "premultiplied"
          ]
        },
        "assetId": {
          "$ref": "#/$defs/__schema0"
        },
        "checksum": {
          "$ref": "#/$defs/__schema0"
        },
        "colorSpace": {
          "type": "string",
          "const": "srgb"
        },
        "mediaType": {
          "type": "string",
          "const": "image/png"
        },
        "pixelSize": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "alphaMode",
        "assetId",
        "checksum",
        "colorSpace",
        "mediaType",
        "pixelSize"
      ],
      "additionalProperties": false
    }
  }
}
