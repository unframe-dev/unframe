{
  "name": "@unframe/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./control-plane": "./src/control-plane.openapi.ts",
    "./presentation": "./src/presentation/index.ts"
  },
  "scripts": {
    "generate:control-plane": "tsx scripts/generate-control-plane.ts",
    "check:control-plane": "tsx scripts/generate-control-plane.ts --check",
    "generate:presentation": "tsx scripts/generate-presentation.ts",
    "check:presentation": "tsx scripts/generate-presentation.ts --check",
    "test:presentation": "tsx --test test/presentation.contract.test.ts test/runtime-projection.contract.test.ts test/public-contract.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "vp check src/presentation scripts test",
    "check": "pnpm check:control-plane && pnpm check:presentation && pnpm check:wire-descriptor && pnpm check:wire-static && pnpm check:wire-types && pnpm check:wire-fixtures && pnpm typecheck && pnpm test:presentation && pnpm test:wire && pnpm lint",
    "generate:wire-descriptor": "tsx scripts/generate-wire-descriptor.ts",
    "check:wire-descriptor": "tsx scripts/generate-wire-descriptor.ts --check",
    "generate:wire-static": "tsx scripts/generate-wire-static.ts",
    "check:wire-static": "tsx scripts/generate-wire-static.ts --check",
    "generate:wire-types": "tsx scripts/generate-wire-types.ts",
    "check:wire-types": "tsx scripts/generate-wire-types.ts --check",
    "generate:wire-fixtures": "tsx scripts/generate-wire-fixtures.ts",
    "check:wire-fixtures": "tsx scripts/generate-wire-fixtures.ts --check",
    "test:wire": "tsx --test test/wire-conformance.test.ts test/wire-long.test.ts"
  },
  "dependencies": {
    "long": "5.3.2",
    "protobufjs": "7.5.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260927.1",
    "@types/node": "^24.0.0",
    "ajv": "8.20.0",
    "canonicalize": "3.0.0",
    "openapi-typescript": "^7.12.0",
    "protobufjs-cli": "2.7.0",
    "tsx": "^4.22.1",
    "typescript": "^5.9.3",
    "vite-plus": "catalog:"
  }
}
