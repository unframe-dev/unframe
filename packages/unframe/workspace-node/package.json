{
  "name": "@unframe/workspace-node",
  "version": "0.0.1",
  "private": false,
  "bin": {
    "unframe-filesystem-helper-darwin-arm64": "./native-bin/filesystem-helper-darwin-arm64",
    "unframe-filesystem-helper-linux-x64": "./native-bin/filesystem-helper-linux-x64"
  },
  "files": [
    "dist",
    "native-bin"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "vp check src test vite.config.ts",
    "pretest": "bash ../../../scripts/build-cli-filesystem.sh",
    "test": "vp test run",
    "build": "bash ../../../scripts/build-cli-filesystem.sh && NODE_OPTIONS=--max-old-space-size=8192 vp pack",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@unframe/artifacts": "workspace:*",
    "@unframe/build": "workspace:*",
    "@unframe/workspace": "workspace:*",
    "typescript": "6.0.3",
    "yaml": "2.9.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@unframe/contracts": "workspace:*",
    "vite-plus": "catalog:"
  }
}
