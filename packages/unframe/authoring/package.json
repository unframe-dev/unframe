{
  "name": "@unframe/authoring",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./components": "./src/components/index.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx-dev-runtime.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./components": {
        "types": "./dist/components.d.mts",
        "import": "./dist/components.mjs"
      },
      "./jsx-runtime": {
        "types": "./dist/jsx-runtime.d.mts",
        "import": "./dist/jsx-runtime.mjs"
      },
      "./jsx-dev-runtime": {
        "types": "./dist/jsx-dev-runtime.d.mts",
        "import": "./dist/jsx-dev-runtime.mjs"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "vp check src test vite.config.ts",
    "test": "vp test run",
    "build": "vp pack",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@types/react": "19.3.0",
    "@unframe/presentation": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "6.0.3",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
