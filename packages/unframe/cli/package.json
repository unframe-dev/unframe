{
  "name": "@unframe-dev/cli",
  "version": "0.0.1",
  "private": false,
  "bin": {
    "unframe": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "template",
    "analysis"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./template": "./template/package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./template": "./template/package.json"
    }
  },
  "scripts": {
    "dev": "bun src/process/editor-dev.ts",
    "tui": "bun --preload @opentui/solid/preload src/tui/main.tsx",
    "presentation": "bun src/process/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "vp check src test vite.config.ts",
    "test": "vp test run --exclude \"**/*.integration.test.ts\" --exclude \"test-bun/**\" --maxWorkers=2 --testTimeout=60000",
    "test:tui": "bun test --preload @opentui/solid/preload ./test-bun/tui-render.test.bun.tsx",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 vp pack",
    "check": "pnpm --config.verify-deps-before-run=false typecheck && pnpm --config.verify-deps-before-run=false lint && pnpm --config.verify-deps-before-run=false test && pnpm --config.verify-deps-before-run=false test:tui && pnpm --config.verify-deps-before-run=false build",
    "pretest": "bash ../../../scripts/build-cli-filesystem.sh && pnpm --config.verify-deps-before-run=false run build:analysis",
    "predev": "bash ../../../scripts/build-cli-filesystem.sh && pnpm --config.verify-deps-before-run=false --filter @unframe-dev/styles-node run build && pnpm --config.verify-deps-before-run=false run build:analysis",
    "prepresentation": "bash ../../../scripts/build-cli-filesystem.sh && pnpm --config.verify-deps-before-run=false --filter @unframe-dev/styles-node run build && pnpm --config.verify-deps-before-run=false run build:analysis",
    "pretui": "bash ../../../scripts/build-cli-filesystem.sh && pnpm --config.verify-deps-before-run=false --filter @unframe-dev/styles-node run build && pnpm --config.verify-deps-before-run=false run build:analysis",
    "pretest:tui": "bash ../../../scripts/build-cli-filesystem.sh && pnpm --config.verify-deps-before-run=false run build:analysis",
    "build:analysis": "vp pack --filter author-analysis"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@opentui/core": "0.8.1",
    "@opentui/keymap": "0.8.1",
    "@opentui/solid": "0.8.1",
    "@unframe-dev/artifacts": "workspace:*",
    "@unframe-dev/author-service": "workspace:*",
    "@unframe-dev/authoring": "workspace:*",
    "@unframe-dev/build": "workspace:*",
    "@unframe-dev/compiler": "workspace:*",
    "@unframe-dev/local-editor": "workspace:*",
    "@unframe-dev/media-node": "workspace:*",
    "@unframe-dev/presentation": "workspace:*",
    "@unframe-dev/preview": "workspace:*",
    "@unframe-dev/publish": "workspace:*",
    "@unframe-dev/render-browser": "workspace:*",
    "@unframe-dev/source": "workspace:*",
    "@unframe-dev/styles-node": "workspace:*",
    "@unframe-dev/workspace": "workspace:*",
    "@unframe-dev/workspace-node": "workspace:*",
    "css-tree": "3.2.1",
    "solid-js": "1.9.18",
    "typescript": "6.0.3",
    "ws": "^8.22.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/postcss": "4.3.3",
    "@types/css-tree": "^3.2.0",
    "@types/node": "26.6.6",
    "@types/path-is-inside": "1.0.3",
    "@types/pngjs": "6.0.5",
    "@types/semver": "7.8.0",
    "@types/ssri": "7.1.5",
    "@types/validate-npm-package-name": "4.0.2",
    "@types/ws": "^8.18.2",
    "@unframe-dev/api-client-typescript": "workspace:*",
    "@unframe-dev/contracts": "workspace:*",
    "@unframe-dev/delivery": "workspace:*",
    "@unframe-dev/worker-host": "workspace:*",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "tailwindcss-older": "npm:tailwindcss@4.2.1",
    "tailwindcss-postcss-older": "npm:@tailwindcss/postcss@4.2.1",
    "vite-plus": "catalog:",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24"
  }
}
