{
  "name": "@unframe-dev/artifacts",
  "version": "0.0.1",
  "private": false,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./plain-json": "./src/publication/plain-json.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./plain-json": {
        "types": "./dist/plain-json.d.mts",
        "import": "./dist/plain-json.mjs"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "vp check src test vite.config.ts",
    "test": "vp test run",
    "build": "vp pack",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@unframe-dev/presentation": "workspace:*",
    "canonicalize": "5.1.0",
    "jsonc-parser": "3.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@unframe-dev/contracts": "workspace:*",
    "typescript": "6.0.3",
    "vite-plus": "catalog:"
  }
}
