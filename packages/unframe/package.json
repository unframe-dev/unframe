{
  "name": "@unframe/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./assets": "./assets/src/index.ts",
    "./renderer-api": "./renderer-api/src/index.ts",
    "./renderer-web": "./renderer-web/src/index.ts",
    "./worker-host": "./worker-host/src/index.ts",
    "./tailwind": {
      "types": "./tailwind/src/index.ts",
      "import": "./tailwind/dist/index.js"
    },
    "./cli": "./cli/src/index.ts",
    "./cli/author-contract": "./cli/src/author-contract.ts",
    "./cli/tui": "./cli/src/tui/run.tsx",
    "./cli/preview-contract": "./cli/src/author/preview-contract.ts"
  },
  "scripts": {
    "dev": "bun cli/src/process/editor-dev.ts",
    "tui": "bun --preload @opentui/solid/preload cli/src/tui/main.tsx",
    "presentation": "bun cli/src/process/main.ts",
    "typecheck": "tsc --noEmit -p assets/tsconfig.json && tsc --noEmit -p renderer-api/tsconfig.json && tsc --noEmit -p renderer-web/tsconfig.json && tsc --noEmit -p worker-host/tsconfig.json && tsc --noEmit -p tailwind/tsconfig.json && tsc --noEmit -p cli/tsconfig.json",
    "lint": "vp check assets/src assets/test renderer-api/src renderer-api/test renderer-web/src renderer-web/test worker-host/src worker-host/test tailwind/src tailwind/test cli/src cli/test cli/test-bun",
    "test": "vp test run --exclude \"compiler/**\" --exclude \"authoring/**\" --exclude \"presentation/**\" --exclude \"artifacts/**\" --exclude \"playback/**\" --exclude \"delivery/**\" --exclude \"**/*.integration.test.ts\" --exclude \"tailwind/**\" --exclude \"cli/test-bun/**\" --exclude \"workspace/**\" --exclude \"workspace-node/**\" --exclude \"author-service/**\" --exclude \"build/**\" --exclude \"preview/**\" --exclude \"publish/**\" && pnpm test:tailwind",
    "test:tailwind": "pnpm build:tailwind && node --test tailwind/test/*.test.ts",
    "build:tailwind": "tsc -p tailwind/tsconfig.build.json",
    "test:tui": "bun test --preload @opentui/solid/preload ./cli/test-bun/tui-render.test.bun.tsx",
    "test:native": "go -C workspace-node/native test ./... && go -C workspace-node/native vet ./...",
    "check": "pnpm typecheck && pnpm lint && pnpm test:native && pnpm test && pnpm test:tui",
    "prepare": "pnpm build:tailwind",
    "pretest": "bash ../../scripts/build-cli-filesystem.sh",
    "predev": "bash ../../scripts/build-cli-filesystem.sh",
    "prepresentation": "bash ../../scripts/build-cli-filesystem.sh",
    "pretui": "bash ../../scripts/build-cli-filesystem.sh",
    "pretest:tui": "bash ../../scripts/build-cli-filesystem.sh"
  },
  "dependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@jridgewell/trace-mapping": "0.3.31",
    "@noble/hashes": "2.3.0",
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@types/react": "19.3.0",
    "@unframe/api-client-typescript": "workspace:*",
    "@unframe/artifacts": "workspace:*",
    "@unframe/author-service": "workspace:*",
    "@unframe/authoring": "workspace:*",
    "@unframe/build": "workspace:*",
    "@unframe/compiler": "workspace:*",
    "@unframe/contracts": "workspace:*",
    "@unframe/delivery": "workspace:*",
    "@unframe/playback": "workspace:*",
    "@unframe/presentation": "workspace:*",
    "@unframe/preview": "workspace:*",
    "@unframe/publish": "workspace:*",
    "@unframe/source": "workspace:*",
    "@unframe/workspace": "workspace:*",
    "@unframe/workspace-node": "workspace:*",
    "canonicalize": "3.0.0",
    "css-tree": "3.2.1",
    "error-stack-parser": "2.1.4",
    "gltf-validator": "2.0.0-dev.3.10",
    "jiti": "2.7.0",
    "jsonc-parser": "3.3.1",
    "path-is-inside": "1.0.2",
    "playwright-core": "1.62.1",
    "pngjs": "7.0.0",
    "postcss-load-config": "6.0.1",
    "rolldown": "1.1.5",
    "semver": "7.8.5",
    "solid-js": "1.9.12",
    "ssri": "14.0.0",
    "typescript": "6.0.3",
    "validate-npm-package-name": "8.0.0",
    "web-tree-sitter": "0.25.10",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/postcss": "4.3.3",
    "@types/css-tree": "^3.2.0",
    "@types/node": "24.19.0",
    "@types/path-is-inside": "1.0.2",
    "@types/pngjs": "6.0.5",
    "@types/semver": "7.7.1",
    "@types/ssri": "7.1.5",
    "@types/validate-npm-package-name": "4.0.2",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "tailwindcss-older": "npm:tailwindcss@4.2.1",
    "tailwindcss-postcss-older": "npm:@tailwindcss/postcss@4.2.1",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
