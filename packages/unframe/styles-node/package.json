{
  "name": "@unframe-dev/styles-node",
  "version": "0.0.1",
  "private": false,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./compiler": {
      "types": "./src/compiler.ts",
      "import": "./dist/compiler.mjs"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./compiler": {
        "types": "./dist/compiler.d.mts",
        "import": "./dist/compiler.mjs"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "vp check src test scripts vite.config.ts",
    "test": "node --test test/acceptance.test.ts test/diagnostics.test.ts test/schema.test.ts && vp test run test/styles-node-snapshot.test.ts test/styles-darwin-runtime.test.ts test/style-worker-runtime.test.ts test/style-worker-location.test.ts test/style-package-roots.test.ts",
    "build": "vp pack && cp src/style-worker.ts dist/style-worker.ts && node scripts/pack-lock.ts && tsx scripts/pack-dependencies.ts"
  },
  "dependencies": {
    "@unframe-dev/build": "workspace:*",
    "@unframe-dev/worker-host": "workspace:*",
    "@unframe-dev/workspace": "workspace:*",
    "error-stack-parser": "2.1.4",
    "jiti": "2.7.0",
    "jsonc-parser": "3.3.1",
    "path-is-inside": "1.0.2",
    "postcss-load-config": "6.0.1",
    "semver": "7.8.5",
    "typescript": "6.0.3",
    "yaml": "2.9.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.6",
    "@types/path-is-inside": "1.0.3",
    "@types/semver": "7.8.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "tailwindcss-older": "npm:tailwindcss@4.2.1",
    "tailwindcss-postcss-older": "npm:@tailwindcss/postcss@4.2.1",
    "tsx": "^4.22.1",
    "vite-plus": "catalog:"
  }
}
