{
  "name": "@unframe/preview",
  "version": "0.0.1",
  "private": false,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "vp check src test vite.config.ts",
    "test": "vp test run",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 vp pack",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@unframe/artifacts": "workspace:*",
    "@unframe/delivery": "workspace:*",
    "@unframe/playback": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@unframe/contracts": "workspace:*",
    "typescript": "6.0.3",
    "vite-plus": "catalog:"
  }
}
