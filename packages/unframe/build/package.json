{
  "name": "@unframe-dev/build",
  "version": "0.0.1",
  "private": false,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "vp check src test vite.config.ts",
    "test": "vp test run",
    "build": "vp pack",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@unframe-dev/artifacts": "workspace:*",
    "@unframe-dev/authoring": "workspace:*",
    "@unframe-dev/compiler": "workspace:*",
    "@unframe-dev/presentation": "workspace:*",
    "@unframe-dev/source": "workspace:*",
    "@unframe-dev/workspace": "workspace:*",
    "css-tree": "3.2.1",
    "typescript": "6.0.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/css-tree": "^3.2.0",
    "@types/node": "26.6.6",
    "@unframe-dev/contracts": "workspace:*",
    "vite-plus": "catalog:"
  }
}
