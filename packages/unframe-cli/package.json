{
  "name": "@unframe/unframe-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./author-contract": "./src/author-contract.ts",
    "./tui": "./src/tui/run.tsx",
    "./preview-contract": "./src/author/preview-contract.ts"
  },
  "scripts": {
    "dev": "bun src/process/editor-dev.ts",
    "tui": "bun src/tui/main.tsx",
    "presentation": "bun src/process/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "vp check src test test-bun",
    "test": "vp test run --exclude 'test/*.integration.test.ts'",
    "test:tui": "bun test ./test-bun/tui-render.test.bun.tsx",
    "check": "pnpm typecheck && pnpm lint && pnpm test:native && pnpm test && pnpm test:tui",
    "pretest": "bash ../../scripts/build-cli-filesystem.sh",
    "predev": "bash ../../scripts/build-cli-filesystem.sh",
    "prepresentation": "bash ../../scripts/build-cli-filesystem.sh",
    "pretui": "bash ../../scripts/build-cli-filesystem.sh",
    "pretest:tui": "bash ../../scripts/build-cli-filesystem.sh",
    "test:native": "go -C native test ./... && go -C native vet ./..."
  },
  "dependencies": {
    "@opentui/core": "0.8.1",
    "@opentui/keymap": "0.8.1",
    "@opentui/solid": "0.8.1",
    "@unframe/api-client-typescript": "workspace:*",
    "@unframe/contracts": "workspace:*",
    "@unframe/unframe-assets": "workspace:*",
    "@unframe/unframe-compiler": "workspace:*",
    "@unframe/unframe-core": "workspace:*",
    "@unframe/unframe-renderer-web": "workspace:*",
    "@unframe/unframe-tailwind": "workspace:*",
    "@unframe/unframe-worker-host": "workspace:*",
    "canonicalize": "5.1.0",
    "semver": "7.8.5",
    "solid-js": "1.9.18",
    "ssri": "14.0.0",
    "typescript": "7.0.2",
    "validate-npm-package-name": "8.0.0",
    "web-tree-sitter": "0.27.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/semver": "7.7.1",
    "@types/ssri": "7.1.5",
    "@types/validate-npm-package-name": "4.0.2",
    "@unframe/unframe-components": "workspace:*",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
