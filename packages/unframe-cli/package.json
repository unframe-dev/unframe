{
  "name": "@unframe/unframe-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./author-contract": "./src/author-contract.ts",
    "./tui": "./src/tui/run.tsx"
  },
  "scripts": {
    "tui": "bun src/tui/main.tsx",
    "presentation": "bun src/process/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "vp check src test test-bun",
    "test": "vp test run --exclude 'test/*.integration.test.ts'",
    "test:tui": "bun test ./test-bun/tui-render.test.bun.tsx",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:tui"
  },
  "dependencies": {
    "@opentui/core": "0.5.14",
    "@opentui/keymap": "0.5.14",
    "@opentui/solid": "0.5.14",
    "@unframe/unframe-compiler": "workspace:*",
    "@unframe/unframe-core": "workspace:*",
    "@unframe/unframe-renderer-web": "workspace:*",
    "solid-js": "1.9.15",
    "typescript": "7.0.2",
    "web-tree-sitter": "0.27.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@unframe/unframe-components": "workspace:*",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
