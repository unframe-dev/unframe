{
  "extends": "../../../config/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@unframe/unframe-authoring",
    "paths": {
      "@unframe/unframe-authoring": ["../../../unframe-authoring/src/index.ts"],
      "@unframe/unframe-authoring/jsx-runtime": ["../../../unframe-authoring/src/jsx-runtime.ts"]
    },
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["./**/*.ts", "./**/*.tsx"]
}
