{
  "name": "@unframe/control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./rpc": "./src/rpc.ts"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --project test/tsconfig.json --noEmit",
    "lint": "vp lint",
    "test": "vitest run && vitest run --config vitest.startup.config.ts",
    "build": "wrangler deploy --dry-run",
    "types": "wrangler types ./src/worker-configuration.d.ts --include-runtime=false --env-interface CloudflareBindings",
    "types:check": "wrangler types ./src/worker-configuration.d.ts --include-runtime=false --env-interface CloudflareBindings --check",
    "auth:schema:generate": "pnpm exec auth generate --config ./auth.cli.ts --output ./.generated/better-auth.sql --yes",
    "db:migrate:local": "wrangler d1 migrations apply unframe-control-plane --local",
    "db:migrate:remote": "wrangler d1 migrations apply unframe-control-plane --remote",
    "r2:cors:apply": "wrangler r2 bucket cors set unframe-assets --file ./r2-cors.json",
    "r2:cors:list": "wrangler r2 bucket cors list unframe-assets",
    "contracts:check": "pnpm --filter @unframe/contracts check:control-plane",
    "client:check": "pnpm --filter @unframe/api-client-typescript check",
    "check": "pnpm types:check && pnpm typecheck && pnpm lint && pnpm test && pnpm contracts:check && pnpm client:check && pnpm build"
  },
  "dependencies": {
    "@better-auth/infra": "0.4.2",
    "@hono/zod-openapi": "^1.5.2",
    "aws4fetch": "1.0.20",
    "better-auth": "1.7.1",
    "drizzle-orm": "0.45.2",
    "hono": "^4.13.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "5.20260825.1",
    "auth": "1.7.1",
    "typescript": "^7.0.0",
    "vite-plus": "catalog:",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
