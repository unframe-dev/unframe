{
  "rules": [
    {
      "allowed": {
        "origins": ["https://un-fra.me"],
        "methods": ["GET", "PUT"],
        "headers": ["content-type", "content-length", "x-amz-checksum-sha256"]
      },
      "exposeHeaders": ["etag"],
      "maxAgeSeconds": 3600
    },
    {
      "allowed": {
        "origins": ["https://app.un-fra.me"],
        "methods": ["GET"]
      },
      "maxAgeSeconds": 3600
    }
  ]
}
