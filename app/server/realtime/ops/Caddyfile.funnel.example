{
	admin off
	auto_https disable_redirects
	servers {
		timeouts {
			# Realtime gRPC streams can remain open without client messages.
			read_body_idle -1s
		}
	}
}

https://{$FUNNEL_HOSTNAME}:8443 {
	bind 127.0.0.1

	handle /browser/* {
		reverse_proxy http://127.0.0.1:9090
	}

	handle {
		reverse_proxy h2c://127.0.0.1:9090
	}
}
