REALTIME_CONTROL_PLANE_URL=https://api.un-fra.me
# Use the same value as the Control Plane's SERVICE_IDENTITY_SECRET.
REALTIME_SERVICE_IDENTITY=''
REALTIME_RUNTIME_ID=home-realtime-01
# Explicit admission limit; tune only after testing the deployed public path.
REALTIME_HOST_CAPACITY=2
REALTIME_HOST_DRAIN=false
REALTIME_RUNTIME_ENDPOINT=https://realtime.un-fra.me
REALTIME_LISTEN_ADDR=127.0.0.1:9090
REALTIME_ISSUER=https://api.un-fra.me
REALTIME_AUDIENCE=unframe-realtime-runtime
REALTIME_JWKS_URL=https://api.un-fra.me/.well-known/jwks.json
# Replace with the deployed Audience's HTTPS origin; separate multiple origins with commas.
REALTIME_BROWSER_ORIGINS=https://audience.example.test

# Only needed when the Control Plane uses a private CA; this is not Caddy's certificate.
# SSL_CERT_FILE=/absolute/path/to/control-plane-ca.pem
