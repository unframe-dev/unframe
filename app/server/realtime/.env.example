# Standalone cmd/server is for a provisioned Venue Edge assignment.
# Cloud Hosts use ops/runtime-host.env.example.
REALTIME_LISTEN_ADDR=:9090
REALTIME_ISSUER=https://control-plane.example.test
REALTIME_AUDIENCE=unframe-realtime-runtime
REALTIME_JWKS_URL=https://control-plane.example.test/.well-known/jwks.json
REALTIME_SESSION_ID=session-id
REALTIME_RUNTIME_ID=runtime-id
REALTIME_RUNTIME_KIND=VenueEdge
REALTIME_RUNTIME_ENDPOINT=https://runtime.example.test
REALTIME_ASSIGNMENT_EPOCH=1
REALTIME_PRESENTATION_REVISION=1
REALTIME_ASSIGNMENT_ISSUED_AT=2099-01-01T00:00:00Z
REALTIME_LEASE_EXPIRES_AT=2099-01-01T00:10:00Z
REALTIME_CONTROL_PLANE_URL=https://control-plane.example.test
REALTIME_SERVICE_IDENTITY=replace-with-control-plane-service-identity

# For another deployment, replace the Audience HTTPS origin; empty disables browser transport.
REALTIME_BROWSER_ORIGINS=https://app.un-fra.me

VENUE_EDGE_TLS_CERT_FILE=/absolute/path/to/venue-cert.pem
VENUE_EDGE_TLS_KEY_FILE=/absolute/path/to/venue-key.pem
VENUE_EDGE_CACHE_DIR=/absolute/path/to/venue-cache
# Use the same Audience HTTPS origin as the browser transport.
VENUE_EDGE_WEB_ORIGIN=https://app.un-fra.me
