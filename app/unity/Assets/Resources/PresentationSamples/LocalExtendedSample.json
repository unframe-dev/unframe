{
  "schemaVersion": "1.0.0",
  "presentation": {
    "id": "local_motion_trigger_sample",
    "title": "Right Swipe Motion Trigger Sample",
    "stage": {
      "size": {
        "width": 4.0,
        "height": 2.5,
        "depth": 4.0
      },
      "coordinateSystem": {
        "unit": "meter",
        "upAxis": "y",
        "horizontalAxis": "x",
        "audienceDirection": "positiveZ"
      },
      "zones": []
    },
    "assets": [],
    "groups": [
      {
        "id": "group_motion_demo",
        "name": "Right Swipe Motion Demo",
        "trigger": {
          "type": "presentationStart"
        },
        "elements": [
          {
            "id": "motion_panel",
            "type": "shape",
            "content": {
              "shape": "rectangle",
              "size": {
                "width": 2.4,
                "height": 1.4
              },
              "fill": {
                "color": [0.03, 0.07, 0.15, 0.92]
              }
            },
            "initialState": {
              "visible": true,
              "transform": {
                "position": [0.0, 1.35, 2.2],
                "rotation": [0.0, 0.0, 0.0],
                "scale": [1.0, 1.0, 1.0]
              }
            }
          },
          {
            "id": "motion_before",
            "type": "text",
            "content": {
              "text": "右トリガーを押しながら\n右へスワイプ",
              "fontSize": 0.12,
              "alignment": "center",
              "color": [1.0, 1.0, 1.0, 1.0]
            },
            "initialState": {
              "visible": true,
              "transform": {
                "position": [0.0, 1.45, 2.1],
                "rotation": [0.0, 0.0, 0.0],
                "scale": [1.0, 1.0, 1.0]
              }
            }
          },
          {
            "id": "motion_after",
            "type": "text",
            "content": {
              "text": "swipe_right 発生\nモーション入力成功",
              "fontSize": 0.12,
              "alignment": "center",
              "color": [0.4, 1.0, 0.7, 1.0]
            },
            "initialState": {
              "visible": false,
              "transform": {
                "position": [0.0, 1.45, 2.1],
                "rotation": [0.0, 0.0, 0.0],
                "scale": [1.0, 1.0, 1.0]
              }
            }
          },
          {
            "id": "motion_status",
            "type": "text",
            "content": {
              "text": "待機中",
              "fontSize": 0.07,
              "alignment": "center",
              "color": [0.55, 0.75, 1.0, 1.0]
            },
            "initialState": {
              "visible": true,
              "transform": {
                "position": [0.0, 1.05, 2.1],
                "rotation": [0.0, 0.0, 0.0],
                "scale": [1.0, 1.0, 1.0]
              }
            }
          }
        ],
        "dynamicGroups": [],
        "steps": [
          {
            "id": "step_swipe_right",
            "cues": [
              {
                "id": "cue_swipe_right",
                "trigger": {
                  "type": "motion",
                  "reference": "swipe_right"
                },
                "actions": [
                  {
                    "targetId": "motion_before",
                    "type": "setVisible",
                    "value": false
                  },
                  {
                    "targetId": "motion_status",
                    "type": "setVisible",
                    "value": false
                  },
                  {
                    "targetId": "motion_after",
                    "type": "setVisible",
                    "value": true
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
