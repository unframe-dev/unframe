{
  "schemaVersion": "1.0.0",
  "presentation": {
    "id": "local_sample",
    "title": "Local MR Sample",
    "assets": [],
    "groups": [
      {
        "id": "group_local_sample",
        "name": "Local Sample",
        "trigger": {
          "type": "presentationStart"
        },
        "elements": [
          {
            "id": "sample_panel",
            "type": "shape",
            "content": {
              "shape": "rectangle",
              "size": {
                "width": 1.8,
                "height": 1.0
              },
              "fill": {
                "color": [0.04, 0.08, 0.14, 0.9]
              }
            },
            "initialState": {
              "visible": true,
              "opacity": 0.9,
              "transform": {
                "position": [0.0, 1.4, 2.0],
                "rotation": [0.0, 0.0, 0.0],
                "scale": [1.0, 1.0, 1.0]
              }
            }
          },
          {
            "id": "sample_title",
            "type": "text",
            "content": {
              "text": "ローカルMRプレゼンテーション",
              "fontSize": 0.12,
              "alignment": "center",
              "color": [1.0, 1.0, 1.0, 1.0]
            },
            "initialState": {
              "visible": true,
              "transform": {
                "position": [0.0, 1.55, 1.95],
                "rotation": [0.0, 0.0, 0.0],
                "scale": [1.0, 1.0, 1.0]
              }
            }
          }
        ],
        "dynamicGroups": [],
        "steps": [
          {
            "id": "step_01",
            "cues": [
              {
                "id": "cue_hide_title",
                "trigger": {
                  "type": "input",
                  "condition": {
                    "input": "primary",
                    "state": "pressed"
                  }
                },
                "actions": [
                  {
                    "targetId": "sample_title",
                    "type": "setVisible",
                    "value": false
                  }
                ],
                "nextStep": "step_02"
              }
            ]
          },
          {
            "id": "step_02",
            "cues": [
              {
                "id": "cue_expand_panel",
                "trigger": {
                  "type": "input",
                  "condition": {
                    "input": "next",
                    "state": "pressed"
                  }
                },
                "actions": [
                  {
                    "targetId": "sample_panel",
                    "type": "setScale",
                    "value": [1.15, 1.1, 1.0]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
