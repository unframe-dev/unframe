{
  "name": "@unframe/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "dev:e2e": "vp dev --mode e2e --host 127.0.0.1 --port 4173",
    "build": "vp build",
    "check": "tsc --noEmit",
    "test": "vp test run",
    "test:e2e": "playwright test",
    "preview": "vp preview",
    "cf:dev": "wrangler dev",
    "cf:types": "wrangler types --include-runtime=false --env-interface CloudflareBindings",
    "cf:deploy": "wrangler deploy",
    "cf:deploy:dry-run": "wrangler deploy --dry-run",
    "build:editor": "vp build --config vite.editor.config.ts && mv dist-editor/editor.html dist-editor/index.html"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "5.9.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "5.102.3",
    "@tanstack/react-router": "1.170.32",
    "@unframe/api-client-typescript": "workspace:*",
    "@unframe/unframe-cli": "workspace:*",
    "@unframe/unframe-core": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "7.86.0",
    "tailwind-merge": "^3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.61.0",
    "@cloudflare/workers-types": "5.20260927.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.0",
    "vite": "catalog:",
    "vitest": "4.1.11",
    "wrangler": "4.142.0"
  }
}
