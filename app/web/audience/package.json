{
  "name": "@unframe/audience",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-engine.ts && node scripts/prepare-detectors.ts",
    "dev": "vp dev",
    "prebuild": "node scripts/prepare-engine.ts && node scripts/prepare-detectors.ts",
    "build": "vp build",
    "preview": "vp preview",
    "check": "tsc --noEmit && vp lint src scripts worker vite.config.ts vitest.config.ts",
    "test": "vp test run",
    "markers:generate": "node scripts/generate-marker-board.ts",
    "precheck": "node scripts/prepare-detectors.ts",
    "pretest": "node scripts/prepare-detectors.ts",
    "cf:deploy": "wrangler deploy --config wrangler.toml",
    "cf:deploy:dry-run": "wrangler deploy --config wrangler.toml --dry-run",
    "cf:tail": "wrangler tail --config wrangler.toml"
  },
  "dependencies": {
    "@8thwall/engine-binary": "1.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@unframe/api-client-typescript": "workspace:*",
    "@unframe/contracts": "workspace:*",
    "js-aruco2": "2.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.183.2",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.183.1",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "tailwindcss": "4.3.2",
    "typescript": "^7.0.0",
    "vite": "catalog:",
    "vitest": "4.1.11",
    "wrangler": "4.142.0"
  }
}
