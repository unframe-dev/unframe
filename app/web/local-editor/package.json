{
  "name": "@unframe-dev/local-editor",
  "version": "0.1.0",
  "private": false,
  "files": [
    "dist",
    "player",
    "package.mjs",
    "package.d.mts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./package.d.mts",
      "import": "./package.mjs"
    }
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "check": "tsc --noEmit",
    "test": "vp test run",
    "build:distribution": "nix run ../../..#unity-preview && vp build && node package-player.ts && node --test test/package.check.ts",
    "prepack": "pnpm --config.verify-deps-before-run=false run build:distribution"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@phosphor-icons/react": "2.1.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "4.16.1",
    "zod": "4.4.3",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@unframe-dev/contracts": "workspace:*",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.0",
    "vite": "catalog:"
  }
}
