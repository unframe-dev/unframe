{
  "openapi": "3.1.0",
  "info": {
    "title": "Unframe Backend",
    "version": "0.0.0",
    "description": "MR プレゼンテーションアプリ Unframe のバックエンド API"
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "description": "サービスが応答可能であることを示す固定値。",
            "example": "ok"
          },
          "uptime": {
            "type": "number",
            "minimum": 0,
            "description": "プロセス起動からの経過秒。Worker isolate ごとにリセットされる。",
            "example": 123.456
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "サーバ側の現在時刻 (ISO 8601 / UTC)。",
            "example": "2026-05-19T12:00:00.000Z"
          }
        },
        "required": [
          "status",
          "uptime",
          "timestamp"
        ],
        "description": "GET /health のレスポンス。DB / Storage の到達性は確認しない liveness プローブ。"
      },
      "StorageKey": {
        "type": "string",
        "pattern": "^assets\\/[0-9a-f-]{36}\\.[a-z0-9]+$",
        "description": "Supabase Storage 内のオブジェクトキー。常に `assets/<uuid>.<ext>` の形式。",
        "example": "assets/3f8a0c0a-1111-4222-8333-444455556666.png"
      },
      "InitAssetResponse": {
        "type": "object",
        "properties": {
          "assetId": {
            "type": "string",
            "format": "uuid",
            "description": "発行されたアセット ID。以後 presentation の参照 (`assetId`) で使う。",
            "example": "3f8a0c0a-1111-4222-8333-444455556666"
          },
          "uploadUrl": {
            "type": "string",
            "format": "uri",
            "description": "Supabase Storage への signed upload URL。クライアントはこの URL に対して Worker を経由せず直接 PUT する。",
            "example": "https://placeholder.supabase.co/storage/v1/upload/sign/assets/3f8a0c0a-1111-4222-8333-444455556666.fbx?token=..."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "uploadUrl の有効期限 (ISO 8601 / UTC)。",
            "example": "2026-05-19T13:00:00.000Z"
          },
          "storageKey": {
            "$ref": "#/components/schemas/StorageKey"
          }
        },
        "required": [
          "assetId",
          "uploadUrl",
          "expiresAt",
          "storageKey"
        ],
        "description": "POST /assets/init の 201 レスポンス。"
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "validation_error",
          "not_found",
          "conflict",
          "payload_too_large",
          "unsupported_media_type",
          "internal_error"
        ],
        "description": "API エラー種別。HTTP ステータスとは別軸で、クライアントが分岐に使う安定識別子。対応表は docs/api/endpoints.md 「共通エラー形」を参照。",
        "example": "validation_error"
      },
      "ErrorBody": {
        "type": "object",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "description": "人間向けの簡潔なエラー説明 (デバッグ用)。UI 表示にそのまま使わない。",
            "example": "Request validation failed"
          },
          "details": {
            "nullable": true,
            "description": "code に応じた補助情報。validation_error の場合は Zod issues 配列、参照不整合の場合は { field, missing[] } のような構造を取る。"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "description": "エラー応答 body の中身 (error フィールドの値)。"
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "description": "全エラーレスポンスの共通形。ステータスコードによらず必ずこの形を返す。",
        "example": {
          "error": {
            "code": "validation_error",
            "message": "Request validation failed",
            "details": [
              {
                "path": [
                  "sizeBytes"
                ],
                "message": "Number must be less than or equal to 52428800",
                "code": "too_big"
              }
            ]
          }
        }
      },
      "PresentationCreatedResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "新規作成されたプレゼン ID。",
            "example": "p0000000-0000-4000-8000-000000000001"
          }
        },
        "required": [
          "id"
        ],
        "description": "POST /presentations の 201 レスポンス。"
      },
      "Vec3": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "z": {
            "type": "number"
          }
        },
        "required": [
          "x",
          "y",
          "z"
        ],
        "description": "3D ベクトル。座標系は Unity 準拠 (右手 / Y-up / meter)。",
        "example": {
          "x": 0,
          "y": 1,
          "z": -2
        }
      },
      "Transform": {
        "type": "object",
        "properties": {
          "position": {
            "$ref": "#/components/schemas/Vec3"
          },
          "rotation": {
            "$ref": "#/components/schemas/Vec3"
          },
          "scale": {
            "$ref": "#/components/schemas/Vec3"
          }
        },
        "required": [
          "position",
          "rotation",
          "scale"
        ],
        "description": "MR 空間内での要素の配置情報 (位置 / 回転 [度] / スケール)。",
        "example": {
          "position": {
            "x": 0,
            "y": 1.5,
            "z": -2
          },
          "rotation": {
            "x": 0,
            "y": 0,
            "z": 0
          },
          "scale": {
            "x": 1,
            "y": 1,
            "z": 1
          }
        }
      },
      "TextElement": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "e1111111-1111-4111-8111-111111111111"
          },
          "type": {
            "type": "string",
            "enum": [
              "text"
            ]
          },
          "transform": {
            "$ref": "#/components/schemas/Transform"
          },
          "text": {
            "type": "string",
            "example": "Hello MR"
          },
          "fontSize": {
            "type": "number",
            "minimum": 0,
            "exclusiveMinimum": true,
            "example": 24
          },
          "fontColor": {
            "type": "string",
            "minLength": 1,
            "example": "#000000"
          },
          "fontFamily": {
            "type": "string",
            "minLength": 1,
            "example": "Inter"
          },
          "fontWeight": {
            "type": "string",
            "enum": [
              "normal",
              "bold"
            ]
          },
          "textAlign": {
            "type": "string",
            "enum": [
              "left",
              "center",
              "right"
            ]
          }
        },
        "required": [
          "id",
          "type",
          "transform",
          "text",
          "fontSize",
          "fontColor",
          "fontFamily",
          "fontWeight",
          "textAlign"
        ],
        "description": "テキスト要素。MR 上ではビルボード表示を想定。"
      },
      "StoredModelElement": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "e2222222-2222-4222-8222-222222222222"
          },
          "type": {
            "type": "string",
            "enum": [
              "model"
            ]
          },
          "transform": {
            "$ref": "#/components/schemas/Transform"
          },
          "assetId": {
            "type": "string",
            "format": "uuid",
            "description": "参照する 3D モデル (.fbx) のアセット ID。",
            "example": "3f8a0c0a-1111-4222-8333-444455556666"
          },
          "displayName": {
            "type": "string",
            "example": "ロボット"
          }
        },
        "required": [
          "id",
          "type",
          "transform",
          "assetId",
          "displayName"
        ],
        "description": "DB 永続化形 / 入力形のモデル要素 (src を持たない)。"
      },
      "StoredImageElement": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "e4444444-4444-4444-8444-444444444444"
          },
          "type": {
            "type": "string",
            "enum": [
              "image"
            ]
          },
          "transform": {
            "$ref": "#/components/schemas/Transform"
          },
          "assetId": {
            "type": "string",
            "format": "uuid",
            "description": "参照する画像 (png / jpeg / webp) のアセット ID。",
            "example": "cccccccc-1111-4222-8333-444455556666"
          },
          "alt": {
            "type": "string",
            "example": "図解"
          }
        },
        "required": [
          "id",
          "type",
          "transform",
          "assetId"
        ],
        "description": "DB 永続化形 / 入力形の画像要素 (src を持たない)。"
      },
      "ShapeElement": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "e5555555-5555-4555-8555-555555555555"
          },
          "type": {
            "type": "string",
            "enum": [
              "shape"
            ]
          },
          "transform": {
            "$ref": "#/components/schemas/Transform"
          },
          "shape": {
            "type": "string",
            "enum": [
              "rectangle",
              "ellipse"
            ]
          },
          "fillColor": {
            "type": "string",
            "minLength": 1,
            "example": "#ff0066"
          },
          "strokeColor": {
            "type": "string",
            "minLength": 1,
            "example": "#000000"
          },
          "strokeWidth": {
            "type": "number",
            "minimum": 0,
            "example": 2
          }
        },
        "required": [
          "id",
          "type",
          "transform",
          "shape",
          "fillColor",
          "strokeColor",
          "strokeWidth"
        ],
        "description": "図形要素 (矩形 / 楕円)。"
      },
      "StoredSlideElement": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/TextElement"
          },
          {
            "$ref": "#/components/schemas/StoredModelElement"
          },
          {
            "$ref": "#/components/schemas/StoredImageElement"
          },
          {
            "$ref": "#/components/schemas/ShapeElement"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "text": "#/components/schemas/TextElement",
            "model": "#/components/schemas/StoredModelElement",
            "image": "#/components/schemas/StoredImageElement",
            "shape": "#/components/schemas/ShapeElement"
          }
        },
        "description": "DB 永続化形 / 入力形スライド要素のユニオン。model / image は src を持たない。"
      },
      "StoredSlideContent": {
        "type": "object",
        "properties": {
          "elements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StoredSlideElement"
            }
          },
          "background": {
            "type": "string",
            "minLength": 1,
            "example": "#ffffff"
          },
          "notes": {
            "type": "string",
            "example": ""
          }
        },
        "required": [
          "elements",
          "background",
          "notes"
        ],
        "description": "DB 永続化形 / 入力形スライド内容。"
      },
      "SlidePayload": {
        "type": "object",
        "properties": {
          "content": {
            "$ref": "#/components/schemas/StoredSlideContent"
          }
        },
        "required": [
          "content"
        ],
        "description": "プレゼン作成 / 更新時に渡す 1 スライド分の入力。"
      },
      "CreatePresentationRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "プレゼンタイトル。",
            "example": "Demo"
          },
          "thumbnailAssetId": {
            "type": "string",
            "nullable": true,
            "format": "uuid",
            "description": "サムネ画像のアセット ID。null / 省略可。実体は POST /assets/init で発行された ID。",
            "example": "aaaaaaaa-1111-4222-8333-444455556666"
          },
          "slides": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SlidePayload"
            },
            "minItems": 1,
            "description": "スライド配列 (順序は配列順)。省略時はサーバが空の 1 枚を自動生成する。"
          }
        },
        "required": [
          "title"
        ],
        "description": "POST /presentations のリクエスト body。",
        "example": {
          "title": "Demo",
          "thumbnailAssetId": "aaaaaaaa-1111-4222-8333-444455556666",
          "slides": [
            {
              "content": {
                "elements": [],
                "background": "#ffffff",
                "notes": ""
              }
            }
          ]
        }
      },
      "ModelElement": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "e2222222-2222-4222-8222-222222222222"
          },
          "type": {
            "type": "string",
            "enum": [
              "model"
            ]
          },
          "transform": {
            "$ref": "#/components/schemas/Transform"
          },
          "assetId": {
            "type": "string",
            "format": "uuid",
            "description": "参照する 3D モデル (.fbx) のアセット ID。",
            "example": "3f8a0c0a-1111-4222-8333-444455556666"
          },
          "displayName": {
            "type": "string",
            "example": "ロボット"
          },
          "src": {
            "type": "string",
            "format": "uri",
            "description": "Supabase Storage の Public URL。backend がレスポンス組み立て時に assetId から解決する read-only フィールド。"
          }
        },
        "required": [
          "id",
          "type",
          "transform",
          "assetId",
          "displayName"
        ],
        "description": "レスポンス用モデル要素。src に解決済み URL が入る。"
      },
      "ImageElement": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "e4444444-4444-4444-8444-444444444444"
          },
          "type": {
            "type": "string",
            "enum": [
              "image"
            ]
          },
          "transform": {
            "$ref": "#/components/schemas/Transform"
          },
          "assetId": {
            "type": "string",
            "format": "uuid",
            "description": "参照する画像 (png / jpeg / webp) のアセット ID。",
            "example": "cccccccc-1111-4222-8333-444455556666"
          },
          "alt": {
            "type": "string",
            "example": "図解"
          },
          "src": {
            "type": "string",
            "format": "uri",
            "description": "Supabase Storage の Public URL。backend がレスポンス組み立て時に assetId から解決する read-only フィールド。"
          }
        },
        "required": [
          "id",
          "type",
          "transform",
          "assetId"
        ],
        "description": "レスポンス用画像要素。src に解決済み URL が入る。"
      },
      "SlideElement": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/TextElement"
          },
          {
            "$ref": "#/components/schemas/ModelElement"
          },
          {
            "$ref": "#/components/schemas/ImageElement"
          },
          {
            "$ref": "#/components/schemas/ShapeElement"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "text": "#/components/schemas/TextElement",
            "model": "#/components/schemas/ModelElement",
            "image": "#/components/schemas/ImageElement",
            "shape": "#/components/schemas/ShapeElement"
          }
        },
        "description": "レスポンス用スライド要素のユニオン。`type` で分岐する。"
      },
      "SlideContent": {
        "type": "object",
        "properties": {
          "elements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SlideElement"
            }
          },
          "background": {
            "type": "string",
            "minLength": 1,
            "description": "スライド背景色 (CSS color)。MR 側ではスカイドーム色として解釈する。",
            "example": "#ffffff"
          },
          "notes": {
            "type": "string",
            "description": "発表者ノート。MR には送らず、WebApp の発表者ビュー用。",
            "example": ""
          }
        },
        "required": [
          "elements",
          "background",
          "notes"
        ],
        "description": "レスポンス用スライド内容。model / image 要素は src 解決済み。"
      },
      "PresentationSlide": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "s0000000-0000-4000-8000-000000000001"
          },
          "orderIndex": {
            "type": "integer",
            "minimum": 0,
            "description": "プレゼン内での 0 始まりの並び順。",
            "example": 0
          },
          "content": {
            "$ref": "#/components/schemas/SlideContent"
          }
        },
        "required": [
          "id",
          "orderIndex",
          "content"
        ],
        "description": "プレゼン内の 1 スライド (レスポンス形)。"
      },
      "Presentation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "p0000000-0000-4000-8000-000000000001"
          },
          "title": {
            "type": "string",
            "example": "Demo"
          },
          "thumbnailUrl": {
            "type": "string",
            "nullable": true,
            "format": "uri",
            "description": "サムネの Public URL (未設定なら null)。"
          },
          "slides": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PresentationSlide"
            },
            "minItems": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-05-19T11:50:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-05-19T12:30:00.000Z"
          }
        },
        "required": [
          "id",
          "title",
          "thumbnailUrl",
          "slides",
          "createdAt",
          "updatedAt"
        ],
        "description": "GET /presentations/{id} および PUT /presentations/{id} のレスポンス。WebApp の編集再開で使う完全形。"
      },
      "UpdatePresentationRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "thumbnailAssetId": {
            "type": "string",
            "nullable": true,
            "format": "uuid",
            "description": "サムネを差し替え / 外す (null で外す)。アセット本体は削除されない。"
          },
          "slides": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SlidePayload"
            },
            "minItems": 1,
            "description": "渡すと slides 配列を**丸ごと置換**する (差分パッチではない)。"
          }
        },
        "description": "PUT /presentations/{id} のリクエスト body。title / thumbnailAssetId / slides の少なくとも 1 つが必須。"
      },
      "PresentationSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "p0000000-0000-4000-8000-000000000001"
          },
          "title": {
            "type": "string",
            "example": "Demo"
          },
          "thumbnailUrl": {
            "type": "string",
            "nullable": true,
            "format": "uri",
            "description": "サムネの Public URL (未設定なら null)。",
            "example": "https://placeholder.supabase.co/storage/v1/object/public/assets/aaaaaaaa-1111-4222-8333-444455556666.png"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-05-19T11:50:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-05-19T12:30:00.000Z"
          }
        },
        "required": [
          "id",
          "title",
          "thumbnailUrl",
          "createdAt",
          "updatedAt"
        ],
        "description": "一覧用の軽量プレゼン情報。slides は含まない。"
      },
      "PresentationListResponse": {
        "type": "object",
        "properties": {
          "presentations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PresentationSummary"
            }
          }
        },
        "required": [
          "presentations"
        ],
        "description": "GET /presentations のレスポンス。created_at desc 順。"
      },
      "ManifestTextElement": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "text"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "transform": {
            "$ref": "#/components/schemas/Transform"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "id",
          "transform",
          "text"
        ],
        "description": "manifest 内のテキスト要素。WebApp の TextElement よりフィールド数が少ない (MR は表示しか必要としない)。"
      },
      "ManifestAsset": {
        "type": "object",
        "properties": {
          "assetId": {
            "type": "string",
            "format": "uuid",
            "example": "3f8a0c0a-1111-4222-8333-444455556666"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Supabase Storage の Public URL (MR が直接 GET する)。",
            "example": "https://placeholder.supabase.co/storage/v1/object/public/assets/3f8a0c0a-1111-4222-8333-444455556666.fbx"
          },
          "filename": {
            "type": "string",
            "example": "model.fbx"
          },
          "mimeType": {
            "type": "string",
            "example": "application/octet-stream"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0,
            "example": 4096
          }
        },
        "required": [
          "assetId",
          "url",
          "filename",
          "mimeType",
          "sizeBytes"
        ],
        "description": "manifest 内で assetId が解決された後の asset オブジェクト。"
      },
      "ManifestModelElement": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "model"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "transform": {
            "$ref": "#/components/schemas/Transform"
          },
          "asset": {
            "$ref": "#/components/schemas/ManifestAsset"
          }
        },
        "required": [
          "type",
          "id",
          "transform",
          "asset"
        ],
        "description": "manifest 内のモデル要素。`asset` は解決済み。"
      },
      "ManifestImageElement": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "image"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "transform": {
            "$ref": "#/components/schemas/Transform"
          },
          "asset": {
            "$ref": "#/components/schemas/ManifestAsset"
          }
        },
        "required": [
          "type",
          "id",
          "transform",
          "asset"
        ],
        "description": "manifest 内の画像要素。`asset` は解決済み。"
      },
      "ManifestShapeElement": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "shape"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "transform": {
            "$ref": "#/components/schemas/Transform"
          },
          "shape": {
            "type": "string",
            "enum": [
              "rectangle",
              "ellipse"
            ]
          },
          "fillColor": {
            "type": "string"
          },
          "strokeColor": {
            "type": "string"
          },
          "strokeWidth": {
            "type": "number"
          }
        },
        "required": [
          "type",
          "id",
          "transform",
          "shape",
          "fillColor",
          "strokeColor",
          "strokeWidth"
        ],
        "description": "manifest 内の図形要素。"
      },
      "ManifestElement": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ManifestTextElement"
          },
          {
            "$ref": "#/components/schemas/ManifestModelElement"
          },
          {
            "$ref": "#/components/schemas/ManifestImageElement"
          },
          {
            "$ref": "#/components/schemas/ManifestShapeElement"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "text": "#/components/schemas/ManifestTextElement",
            "model": "#/components/schemas/ManifestModelElement",
            "image": "#/components/schemas/ManifestImageElement",
            "shape": "#/components/schemas/ManifestShapeElement"
          }
        },
        "description": "manifest 内の要素ユニオン。`type` で分岐する。"
      },
      "ManifestSlide": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "s0000000-0000-4000-8000-000000000001"
          },
          "orderIndex": {
            "type": "integer",
            "minimum": 0,
            "example": 0
          },
          "elements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ManifestElement"
            }
          }
        },
        "required": [
          "id",
          "orderIndex",
          "elements"
        ],
        "description": "manifest 内の 1 スライド。要素が 0 件でも 200 で返される。"
      },
      "GetManifestResponse": {
        "type": "object",
        "properties": {
          "presentationId": {
            "type": "string",
            "format": "uuid",
            "example": "p0000000-0000-4000-8000-000000000001"
          },
          "title": {
            "type": "string",
            "example": "Demo"
          },
          "slides": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ManifestSlide"
            }
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "プレゼン本体・slides を含む全更新の最新時刻 (manifest の鮮度判定に使う)。",
            "example": "2026-05-19T12:30:00.000Z"
          }
        },
        "required": [
          "presentationId",
          "title",
          "slides",
          "updatedAt"
        ],
        "description": "GET /presentations/{id}/manifest のレスポンス。MR (Unity) が消費する統合ビュー。model / image 要素は assetId が解決済みの asset オブジェクトに展開される。サムネは含まれない。"
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Liveness probe",
        "description": "プロセスが応答可能であることを返す。DB 接続は確認しない。",
        "responses": {
          "200": {
            "description": "サービスが応答可能",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/assets/init": {
      "post": {
        "tags": [
          "assets"
        ],
        "summary": "Init an asset upload (signed URL)",
        "description": "アセットのメタを受け取り、Supabase Storage への signed upload URL を返す。クライアントは返された uploadUrl に対して PUT でファイル本体を直接アップロードする。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "nullable": true
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "アップロード初期化成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InitAssetResponse"
                }
              }
            }
          },
          "400": {
            "description": "バリデーションエラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "ファイルサイズ超過",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "未対応の Content-Type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/presentations": {
      "post": {
        "tags": [
          "presentations"
        ],
        "summary": "Create a presentation (title + 1..N slides)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePresentationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "作成成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PresentationCreatedResponse"
                }
              }
            }
          },
          "400": {
            "description": "バリデーションエラー / 参照不整合",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "presentations"
        ],
        "summary": "List presentations (created_at desc)",
        "responses": {
          "200": {
            "description": "一覧",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PresentationListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/presentations/{id}": {
      "put": {
        "tags": [
          "presentations"
        ],
        "summary": "Update a presentation (title / thumbnail / slides 全置換)",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePresentationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Presentation"
                }
              }
            }
          },
          "400": {
            "description": "バリデーションエラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "存在しない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "presentations"
        ],
        "summary": "Get a single presentation (slides 配列)",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "取得成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Presentation"
                }
              }
            }
          },
          "404": {
            "description": "存在しない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/presentations/{id}/manifest": {
      "get": {
        "tags": [
          "manifest"
        ],
        "summary": "MR が消費する統合マニフェスト",
        "description": "プレゼンの全スライド・全要素を返す。model / image 要素は assetId が解決済みの asset オブジェクト(url / mimeType / sizeBytes / filename) に展開される。",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "取得成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetManifestResponse"
                }
              }
            }
          },
          "404": {
            "description": "存在しない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}
