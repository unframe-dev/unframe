{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard", ":semanticCommits", "group:all"],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 9am on monday"],
  "labels": ["dependencies"],
  "postUpdateOptions": ["pnpmDedupe"],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on monday"]
  },
  "packageRules": [
    {
      "description": "app/server/realtime (Go modules)",
      "matchManagers": ["gomod"],
      "matchFileNames": ["app/server/realtime/go.mod"],
      "commitMessageTopic": "Go module {{depName}}",
      "semanticCommitScope": "realtime"
    },
    {
      "description": "control-plane / app/web/* / packages (npm/pnpm)",
      "matchManagers": ["npm"],
      "semanticCommitScope": "deps",
      "minimumReleaseAge": "12 hours",
      "internalChecksFilter": "strict"
    },
    {
      "description": "app/unity / api-client-csharp (NuGet)",
      "matchManagers": ["nuget"],
      "semanticCommitScope": "unity"
    },
    {
      "description": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "semanticCommitScope": "ci",
      "groupName": "github-actions"
    },
    {
      "description": "flake.nix / flake.lock (Nix)",
      "matchManagers": ["nix"],
      "semanticCommitScope": "repo",
      "groupName": "nix flake"
    },
    {
      "description": "非メジャーの devDependencies はまとめる",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm devDependencies"
    },
    {
      "description": "Compiler APIs and workspace declaration bundling require TypeScript 6",
      "matchManagers": ["npm"],
      "matchPackageNames": ["typescript"],
      "matchFileNames": [
        "packages/unframe/source/package.json",
        "packages/unframe/workspace/package.json",
        "packages/unframe/workspace-node/package.json",
        "packages/unframe/build/package.json",
        "packages/unframe/styles-node/package.json",
        "packages/unframe/media-node/package.json",
        "packages/unframe/cli/package.json",
        "app/web/lp/package.json",
        "packages/contracts/package.json",
        "scripts/unframe-packages/package.json",
        "packages/unframe/presentation/package.json",
        "packages/unframe/artifacts/package.json",
        "packages/unframe/playback/package.json",
        "packages/unframe/delivery/package.json",
        "packages/unframe/compiler/package.json",
        "packages/unframe/author-service/package.json",
        "packages/unframe/preview/package.json",
        "packages/unframe/publish/package.json"
      ],
      "allowedVersions": "<7"
    },
    {
      "description": "Cloudflare Workers pool supports Vitest 4",
      "matchManagers": ["npm"],
      "matchPackageNames": ["vitest"],
      "matchFileNames": ["app/server/control-plane/package.json"],
      "allowedVersions": "^4.1.0"
    },
    {
      "description": "Keep authentication dependencies aligned with the current D1 account schema",
      "matchManagers": ["npm"],
      "matchPackageNames": ["better-auth"],
      "matchFileNames": [
        "app/server/control-plane/package.json",
        "packages/api-client-typescript/package.json"
      ],
      "allowedVersions": "=1.7.1"
    },
    {
      "description": "Keep authentication dependencies aligned with the current D1 account schema",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@better-auth/infra"],
      "matchFileNames": [
        "app/server/control-plane/package.json",
        "packages/api-client-typescript/package.json"
      ],
      "allowedVersions": "=0.4.2"
    },
    {
      "description": "Keep authentication dependencies aligned with the current D1 account schema",
      "matchManagers": ["npm"],
      "matchPackageNames": ["auth"],
      "matchFileNames": [
        "app/server/control-plane/package.json",
        "packages/api-client-typescript/package.json"
      ],
      "allowedVersions": "=1.7.6"
    },
    {
      "description": "Keep portable schema and wire codec behavior until a contract migration",
      "matchManagers": ["npm"],
      "matchPackageNames": ["zod"],
      "allowedVersions": "=4.4.3",
      "matchCurrentVersion": "4.4.3"
    },
    {
      "description": "Keep portable schema and wire codec behavior until a contract migration",
      "matchManagers": ["npm"],
      "matchPackageNames": ["protobufjs"],
      "allowedVersions": "=7.5.6"
    },
    {
      "description": "Keep portable schema and wire codec behavior until a contract migration",
      "matchManagers": ["npm"],
      "matchPackageNames": ["protobufjs-cli"],
      "allowedVersions": "=2.7.0"
    },
    {
      "description": "Keep deliberately older Tailwind fixtures isolated from the current version",
      "matchManagers": ["npm"],
      "matchDepNames": ["tailwindcss-older", "tailwindcss-postcss-older"],
      "matchFileNames": [
        "packages/unframe/styles-node/package.json",
        "packages/unframe/cli/package.json"
      ],
      "enabled": false
    },
    {
      "description": "Keep Chromium aligned with the audited Darwin sandbox policy",
      "matchManagers": ["npm"],
      "matchPackageNames": ["playwright-core"],
      "matchFileNames": ["packages/unframe/render-browser/package.json"],
      "allowedVersions": "=1.62.1"
    }
  ]
}
